{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "OPERATOR_GOOGLE_EMAIL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    }
  },
  "globalEnv": ["NODE_ENV"]
}
