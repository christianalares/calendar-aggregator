{
  "name": "calendar-aggregator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "tsx scripts/railway/local.ts dev",
    "env:generate": "tsx scripts/railway/local.ts env",
    "build": "turbo build",
    "check-types": "turbo check-types && tsc -p scripts/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsx scripts/testing/run.ts",
    "db:generate": "pnpm --filter @calendar-aggregator/db generate",
    "db:migrate": "tsx scripts/railway/local.ts migrate",
    "railway:plan": "tsx scripts/railway/plan.ts",
    "test:browser": "tsx scripts/testing/run.ts browser"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "1.58.2",
    "@railway/cli": "5.62.1",
    "@t3-oss/env-core": "0.13.11",
    "@types/node": "24.10.1",
    "drizzle-orm": "0.45.2",
    "ical.js": "2.2.1",
    "railway": "3.11.0",
    "tsx": "4.21.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "4.1.4",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  }
}
